TEACHER_API_KEY=
TEACHER_MODEL=            # any litellm-format model id, e.g. openai/gpt-4o-mini or anthropic/<model>
TEACHER_API_BASE=         # optional: custom endpoint base URL (e.g. an Anthropic-compatible proxy)
STUDENT_MODE=mock         # mock|vllm
MOCK_STUDENT_MODE=weak    # echo|weak|replay
STUDENT_WEAK_MODEL=       # cheap litellm model id, used when MOCK_STUDENT_MODE=weak
STUDENT_WEAK_API_KEY=     # optional: defaults to TEACHER_API_KEY if unset
STUDENT_WEAK_API_BASE=    # optional: defaults to TEACHER_API_BASE if unset
STUDENT_REPLAY_PATH=      # used when MOCK_STUDENT_MODE=replay
VLLM_BASE_URL=            # used when STUDENT_MODE=vllm (P1+)
